# Contact form (Resend) — https://resend.com
# Copy this file to .env.local and fill in the values.

# API key from Resend. Without it, the form shows a friendly error and asks
# visitors to email you directly instead of crashing.
RESEND_API_KEY=

# Where contact form messages are delivered. Comma-separated addresses allowed.
CONTACT_TO_EMAIL=

# Verified sender. While testing you can use Resend's onboarding address,
# then switch to an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
